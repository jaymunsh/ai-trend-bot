# 이 파일을 .env로 복사한 뒤, 오른쪽 값을 실제 발급 정보로 교체하세요.
# cp .env.example .env
#
# 주의: 완성된 .env 파일은 GitHub나 채팅에 올리지 마세요.

# Telegram @BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰

# 메시지를 받을 개인 채팅 또는 단체방 ID
TELEGRAM_CHAT_ID=여기에_텔레그램_채팅_ID

# Google AI Studio에서 발급받은 Gemini API 키
GEMINI_API_KEY=여기에_Gemini_API_키
GEMINI_MODEL=gemini-3.1-flash-lite

# Meta for Developers에서 발급받은 Threads 장기 액세스 토큰
THREADS_ACCESS_TOKEN=여기에_Threads_액세스_토큰
